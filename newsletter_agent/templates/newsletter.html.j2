<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ subject }}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background: #f3f4f6;
      font-family: Georgia, "Times New Roman", serif;
      color: #111827;
    }
    .wrap {
      max-width: 640px;
      margin: 0 auto;
      padding: 32px 16px;
    }
    .card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      padding: 32px 28px;
    }
    .eyebrow {
      font-family: "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #6b7280;
      margin: 0 0 8px;
    }
    h1 {
      font-size: 28px;
      line-height: 1.25;
      margin: 0 0 12px;
      font-weight: 700;
    }
    .intro {
      font-size: 16px;
      line-height: 1.6;
      color: #374151;
      margin: 0 0 28px;
    }
    .article {
      border-top: 1px solid #e5e7eb;
      padding: 20px 0;
    }
    .article h2 {
      font-size: 18px;
      margin: 0 0 8px;
      line-height: 1.35;
    }
    .article h2 a {
      color: #111827;
      text-decoration: none;
    }
    .article h2 a:hover {
      text-decoration: underline;
    }
    .meta {
      font-family: "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 12px;
      color: #6b7280;
      margin: 0 0 8px;
    }
    .summary {
      font-size: 15px;
      line-height: 1.55;
      color: #374151;
      margin: 0;
    }
    .outro {
      border-top: 1px solid #e5e7eb;
      margin-top: 8px;
      padding-top: 20px;
      font-size: 13px;
      color: #6b7280;
      line-height: 1.5;
    }
    .footer {
      text-align: center;
      font-family: "Segoe UI", Helvetica, Arial, sans-serif;
      font-size: 11px;
      color: #9ca3af;
      margin-top: 16px;
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="card">
      <p class="eyebrow">AI Agents Digest · {{ week_label }}</p>
      <h1>{{ subject }}</h1>
      <p class="intro">{{ intro }}</p>

      {% for article in articles %}
      <div class="article">
        <h2>
          {% if article.url %}
          <a href="{{ article.url }}" target="_blank" rel="noopener noreferrer">{{ article.title }}</a>
          {% else %}
          {{ article.title }}
          {% endif %}
        </h2>
        {% if article.source or article.relevance %}
        <p class="meta">
          {% if article.source %}{{ article.source }}{% endif %}
          {% if article.source and article.relevance %} · {% endif %}
          {% if article.relevance %}{{ article.relevance }}{% endif %}
        </p>
        {% endif %}
        <p class="summary">{{ article.summary or article.snippet }}</p>
      </div>
      {% endfor %}

      <p class="outro">{{ outro }}</p>
    </div>
    <p class="footer">Generated {{ generated_at }} · Simulated send</p>
  </div>
</body>
</html>
